# Comet Healthcare — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
# Port the Express API listens on (Vite proxies /api here in dev)
PORT=4000

# --- Database (PostgreSQL 16 via Prisma) ---
# DATABASE_URL is used by migrations and seeds (owner role).
DATABASE_URL="postgresql://comet:comet@localhost:5432/comet?schema=public"
# DATABASE_URL_APP is used by the API at runtime (non-owner, RLS enforced).
DATABASE_URL_APP="postgresql://comet_app:comet_app@localhost:5432/comet?schema=public&pgbouncer=true"
# When PgBouncer is enabled, point DATABASE_URL_APP at port 6432 instead.
# DATABASE_URL_APP="postgresql://comet_app:comet_app@localhost:6432/comet?schema=public&pgbouncer=true"

# --- Redis (Phase 4+, shared with Phase 5 workers) ---
REDIS_URL="redis://localhost:6379"
# Domain-event stream shared by the outbox publisher and realtime server.
REDIS_EVENT_STREAM="comet.events"
# Outbox → Redis Streams publisher poll interval and retry ceiling.
OUTBOX_POLL_MS=1000
OUTBOX_MAX_ATTEMPTS=10

# --- Realtime (Phase 4) ---
REALTIME_PORT=4001
REALTIME_TOKEN_TTL="5m"
# Comma-separated browser origins allowed to open a socket.
REALTIME_CORS_ORIGINS="http://localhost:4000,http://localhost:5173,http://localhost:5174"
REALTIME_CONSUMER_GROUP="comet-realtime"

# --- Internal messaging DLP (Phase 4) ---
# block = reject restricted patterns; flag = accept and record finding types only.
DLP_MODE="block"

# --- Object storage: Cloudflare R2 (Phase 5) ---
# Leave all four R2_* connection values empty to use the encrypted local fallback.
# With R2 configured the API returns signed PUT/GET URLs; see ADR-0010.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional public base URL for non-sensitive assets; signed URLs are still preferred.
R2_PUBLIC_BASE_URL=""
# Envelope-encryption key for restricted files and the local fallback; never store in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OBJECT_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# --- Files and signed URLs (Phase 5) ---
# Max accepted upload size in bytes (default 25 MB). The API also enforces an allow-list of MIME types.
MAX_UPLOAD_BYTES=26214400
# Lifetime of local/R2 upload and download tickets in seconds (default 15 minutes).
SIGNED_URL_TTL_SECONDS=900
# Local encrypted object root, relative to the repo root unless absolute (fallback only).
LOCAL_OBJECT_DIR="storage/objects"
# Optional ClamAV/AV hook URL. The worker POSTs bytes with X-Comet-File-Id and expects { "clean": boolean }.
# Without a hook, MIME magic-number checks decide; a configured hook that fails
# quarantines the file rather than marking it clean.
FILE_SCAN_HOOK_URL=""
# Timeout for the scan hook in milliseconds (default 10 seconds).
FILE_SCAN_TIMEOUT_MS=10000

# --- Background workers (Phase 5) ---
# Set to "false" to skip BullMQ enqueues in offline development (outbox publishing still runs).
QUEUES_ENABLED="true"
# Redis key prefix for BullMQ queues.
BULLMQ_PREFIX="comet"
# Cron schedule for the retention sweep (default: 02:00 daily).
RETENTION_SWEEP_CRON="0 2 * * *"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Short access tokens require the client to call /api/auth/refresh on 401.
# Leave unset to preserve the legacy 7d storefront token flow.
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_CONCURRENT_SESSIONS=5
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
# HIBP k-anonymity check fails open offline unless this is true.
PASSWORD_BREACH_ENFORCE="false"

# --- OIDC (Phase 3; endpoints return 503 until all three values are set) ---
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:5173/auth/oidc/callback"
OIDC_COMPANY_CODE="COMET"

# --- App URLs (used in emails/links) ---
# Public base URL of the site. Used to build password-reset and confirmation
# links. In dev it's the Vite dev server.
APP_URL="http://localhost:5173"

# --- Password reset links ---
RESET_TOKEN_TTL_SECONDS=3600

# --- Seed ---
# Password used for the seeded admin account (admin@comethealthcare.local).
# The demo client (client@comethealthcare.local) always uses "ClientPass123!".
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Email (external recipients only) ---
# Internal staff messaging never uses SMTP. This gateway is only for password
# resets, customer invoices, supplier RFQs, and regulator correspondence.
# If SMTP_HOST is empty the server runs in "dev mail" mode and prints to console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Comet Healthcare <no-reply@comethealthcare.local>"

# Comma-separated inboxes that receive external lead notifications
INQUIRIES_TO="info@comethealthcare.local"
