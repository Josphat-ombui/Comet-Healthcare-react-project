# Comet Healthcare — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
# Port the Express API listens on (Vite proxies /api here in dev)
PORT=4000

# --- Database (Prisma) ---
# SQLite for local development. Swap to PostgreSQL in production:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/comet?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- App URLs (used in emails/links) ---
# Public base URL of the site. Used to build password-reset and confirmation
# links. In dev it's the Vite dev server.
APP_URL="http://localhost:5173"

# --- Password reset links ---
RESET_TOKEN_TTL_SECONDS=3600

# --- Seed ---
# Password used for the seeded admin account (admin@comethealthcare.local).
# The demo client (client@comethealthcare.local) always uses "ClientPass123!".
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Email (contact/inquiry & password reset) ---
# Comet uses Nodemailer. Fill in a real transactional provider (e.g. Resend,
# SendGrid, SMTP) to actually deliver mail. If SMTP_HOST is empty the server
# runs in "dev mail" mode and prints the mail to the console instead.
# For Resend you could also wire the RESEND_API_KEY into server/lib/mailer.js.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Comet Healthcare <no-reply@comethealthcare.local>"

# Comma-separated inboxes that receive lead notifications
INQUIRIES_TO="info@comethealthcare.local"