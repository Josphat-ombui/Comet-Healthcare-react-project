# Comet Healthcare — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
# Port the Express API listens on (Vite proxies /api here in dev)
PORT=4000

# --- Database (PostgreSQL 16 via Prisma) ---
# DATABASE_URL is used by migrations and seeds (owner role).
DATABASE_URL="postgresql://comet:comet@localhost:5432/comet?schema=public"
# DATABASE_URL_APP is used by the API at runtime (non-owner, RLS enforced).
DATABASE_URL_APP="postgresql://comet_app:comet_app@localhost:5432/comet?schema=public&pgbouncer=true"
# When PgBouncer is enabled, point DATABASE_URL_APP at port 6432 instead.
# DATABASE_URL_APP="postgresql://comet_app:comet_app@localhost:6432/comet?schema=public&pgbouncer=true"

# --- Redis (Phase 4+) ---
REDIS_URL="redis://localhost:6379"

# --- Object storage: Cloudflare R2 (Phase 5+) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
# Envelope-encryption key; never store in the database.
OBJECT_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- App URLs (used in emails/links) ---
# Public base URL of the site. Used to build password-reset and confirmation
# links. In dev it's the Vite dev server.
APP_URL="http://localhost:5173"

# --- Password reset links ---
RESET_TOKEN_TTL_SECONDS=3600

# --- Seed ---
# Password used for the seeded admin account (admin@comethealthcare.local).
# The demo client (client@comethealthcare.local) always uses "ClientPass123!".
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Email (external recipients only) ---
# Internal staff messaging never uses SMTP. This gateway is only for password
# resets, customer invoices, supplier RFQs, and regulator correspondence.
# If SMTP_HOST is empty the server runs in "dev mail" mode and prints to console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Comet Healthcare <no-reply@comethealthcare.local>"

# Comma-separated inboxes that receive external lead notifications
INQUIRIES_TO="info@comethealthcare.local"
