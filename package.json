{
  "name": "comet-healthcare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/realtime",
    "packages/workers",
    "packages/web",
    "packages/cms",
    "packages/erp"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @comet/api",
    "dev:web": "npm run dev -w @comet/web",
    "dev:server": "npm run dev:api",
    "dev:client": "npm run dev:web",
    "build": "npm run build -w @comet/web",
    "lint": "oxlint",
    "preview": "npm run preview -w @comet/web",
    "start": "npm run start -w @comet/api",
    "db:generate": "npm run db:generate -w @comet/api",
    "db:migrate": "npm run db:migrate -w @comet/api",
    "db:deploy": "npm run db:deploy -w @comet/api",
    "db:push": "npm run db:push -w @comet/api",
    "db:reset": "npm run db:reset -w @comet/api",
    "db:seed": "npm run db:seed -w @comet/api",
    "db:studio": "npm run db:studio -w @comet/api",
    "test": "npm run test -w @comet/api",
    "test:smoke": "npm run test:smoke -w @comet/web",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d postgres redis",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.41.0",
    "nodemailer": "^10.0.8",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prisma": "^6.19.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
