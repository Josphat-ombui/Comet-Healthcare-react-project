// ---------------------------------------------------------------------------
// Phase 9 procurement
//
// Header documents carry their own tenant/branch scope, document number, status
// and integer-cent totals. Suppliers are existing FinanceParty rows of type
// SUPPLIER; lines reference InventoryItem and an optional Warehouse. Orders and
// receipts keep an optional scalar/relation link to a FinanceInvoice for
// three-way matching. No finance posting or payment is performed here.
// ---------------------------------------------------------------------------

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  INSPECTED
  REJECTED
  CANCELLED
}

enum SupplierReturnStatus {
  DRAFT
  APPROVED
  SENT
  RECEIVED
  CANCELLED
}

enum MatchStatus {
  PENDING
  MATCHED
  DISCREPANCY
  APPROVED
}

model PurchaseRequisition {
  id             String                     @id @default(cuid())
  companyId      String                     @default("cmp_comet")
  tenant         Company                    @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?                    @relation(fields: [branchId], references: [id])
  number         String
  status         PurchaseRequisitionStatus  @default(DRAFT)
  requisitionDate String
  requiredDate   String?
  supplierId     String?
  supplier       FinanceParty?              @relation("PurchaseRequisitionSupplier", fields: [supplierId], references: [id])
  currency       String                     @default("KES")
  totalCents     Int                        @default(0)
  notes          String?
  classification DataClassification         @default(INTERNAL)
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?                      @relation("PurchaseRequisitionApprovedBy", fields: [approvedById], references: [id])
  createdById    String?
  createdBy      User?                      @relation("PurchaseRequisitionCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  lines          PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, number])
  @@index([companyId, status, requisitionDate])
  @@index([companyId, supplierId])
}

model PurchaseRequisitionLine {
  id             String              @id @default(cuid())
  companyId      String              @default("cmp_comet")
  tenant         Company             @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  requisitionId  String
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  itemId         String
  item           InventoryItem       @relation("PurchaseRequisitionLineItem", fields: [itemId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?          @relation("PurchaseRequisitionLineWarehouse", fields: [warehouseId], references: [id])
  description    String
  qty            Float
  unitCostCents  Int
  totalCents     Int                 @default(0)
  position       Int                 @default(0)
  classification DataClassification  @default(INTERNAL)
  createdById    String?
  createdBy      User?               @relation("PurchaseRequisitionLineCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([requisitionId])
  @@index([companyId, itemId])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  companyId        String              @default("cmp_comet")
  tenant           Company             @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id])
  number           String
  status           PurchaseOrderStatus @default(DRAFT)
  requisitionId    String?
  requisition      PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  supplierId       String
  supplier         FinanceParty        @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id])
  orderDate        String
  expectedDate     String?
  currency         String              @default("KES")
  totalCents       Int                 @default(0)
  notes            String?
  classification   DataClassification  @default(INTERNAL)
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  sentAt           DateTime?
  // Plain link to finance; procurement never creates a journal or payment.
  financeInvoiceId String?
  financeInvoice   FinanceInvoice?     @relation("PurchaseOrderInvoice", fields: [financeInvoiceId], references: [id])
  createdById      String?
  createdBy        User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lines           PurchaseOrderLine[]
  goodsReceipts   GoodsReceipt[]
  threeWayMatches ThreeWayMatch[]

  @@unique([companyId, number])
  @@index([companyId, status, orderDate])
  @@index([companyId, supplierId])
}

model PurchaseOrderLine {
  id             String              @id @default(cuid())
  companyId      String              @default("cmp_comet")
  tenant         Company             @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  orderId        String
  order          PurchaseOrder       @relation(fields: [orderId], references: [id])
  itemId         String
  item           InventoryItem       @relation("PurchaseOrderLineItem", fields: [itemId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?          @relation("PurchaseOrderLineWarehouse", fields: [warehouseId], references: [id])
  description    String
  qty            Float
  receivedQty    Float               @default(0)
  unitCostCents  Int
  totalCents     Int                 @default(0)
  position       Int                 @default(0)
  classification DataClassification  @default(INTERNAL)
  createdById    String?
  createdBy      User?               @relation("PurchaseOrderLineCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  receiptLines GoodsReceiptLine[]

  @@index([orderId])
  @@index([companyId, itemId])
}

model GoodsReceipt {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  number           String
  status           GoodsReceiptStatus @default(DRAFT)
  orderId          String
  order            PurchaseOrder      @relation(fields: [orderId], references: [id])
  supplierId       String
  supplier         FinanceParty       @relation("GoodsReceiptSupplier", fields: [supplierId], references: [id])
  receiptDate      String
  currency         String             @default("KES")
  totalCents       Int                @default(0)
  notes            String?
  classification   DataClassification @default(INTERNAL)
  receivedAt       DateTime?
  inspectedAt      DateTime?
  financeInvoiceId String?
  financeInvoice   FinanceInvoice?    @relation("GoodsReceiptInvoice", fields: [financeInvoiceId], references: [id])
  createdById      String?
  createdBy        User?              @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  lines           GoodsReceiptLine[]
  threeWayMatches ThreeWayMatch[]
  supplierReturns SupplierReturn[]

  @@unique([companyId, number])
  @@index([companyId, status, receiptDate])
  @@index([companyId, orderId])
}

model GoodsReceiptLine {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  receiptId      String
  receipt        GoodsReceipt       @relation(fields: [receiptId], references: [id])
  orderLineId    String
  orderLine      PurchaseOrderLine  @relation(fields: [orderLineId], references: [id])
  itemId         String
  item           InventoryItem      @relation("GoodsReceiptLineItem", fields: [itemId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?         @relation("GoodsReceiptLineWarehouse", fields: [warehouseId], references: [id])
  batchId        String?
  batch          InventoryBatch?    @relation("GoodsReceiptLineBatch", fields: [batchId], references: [id])
  description    String
  qty            Float
  unitCostCents  Int
  totalCents     Int                @default(0)
  position       Int                @default(0)
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("GoodsReceiptLineCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  returnLines SupplierReturnLine[]

  @@index([receiptId])
  @@index([companyId, itemId])
}

model SupplierReturn {
  id             String              @id @default(cuid())
  companyId      String              @default("cmp_comet")
  tenant         Company             @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  number         String
  status         SupplierReturnStatus @default(DRAFT)
  orderId        String
  supplierId     String
  supplier       FinanceParty        @relation("SupplierReturnSupplier", fields: [supplierId], references: [id])
  receiptId      String?
  receipt        GoodsReceipt?       @relation(fields: [receiptId], references: [id])
  returnDate     String
  reason         String?
  currency       String              @default("KES")
  totalCents     Int                 @default(0)
  classification DataClassification  @default(INTERNAL)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?               @relation("SupplierReturnApprovedBy", fields: [approvedById], references: [id])
  sentAt         DateTime?
  receivedAt     DateTime?
  createdById    String?
  createdBy      User?               @relation("SupplierReturnCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines SupplierReturnLine[]

  @@unique([companyId, number])
  @@index([companyId, status, returnDate])
  @@index([companyId, supplierId])
}

model SupplierReturnLine {
  id             String              @id @default(cuid())
  companyId      String              @default("cmp_comet")
  tenant         Company             @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  returnId       String
  return         SupplierReturn      @relation(fields: [returnId], references: [id])
  receiptLineId  String?
  receiptLine    GoodsReceiptLine?   @relation(fields: [receiptLineId], references: [id])
  itemId         String
  item           InventoryItem       @relation("SupplierReturnLineItem", fields: [itemId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?          @relation("SupplierReturnLineWarehouse", fields: [warehouseId], references: [id])
  batchId        String?
  batch          InventoryBatch?     @relation("SupplierReturnLineBatch", fields: [batchId], references: [id])
  description    String
  qty            Float
  unitCostCents  Int
  totalCents     Int                 @default(0)
  position       Int                 @default(0)
  classification DataClassification  @default(INTERNAL)
  createdById    String?
  createdBy      User?               @relation("SupplierReturnLineCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([returnId])
  @@index([companyId, itemId])
}

model ThreeWayMatch {
  id                 String             @id @default(cuid())
  companyId          String             @default("cmp_comet")
  tenant             Company            @relation(fields: [companyId], references: [id])
  branchId           String?
  branch             Branch?            @relation(fields: [branchId], references: [id])
  number             String
  status             MatchStatus        @default(PENDING)
  orderId            String
  order              PurchaseOrder      @relation(fields: [orderId], references: [id])
  receiptId          String?
  receipt            GoodsReceipt?      @relation(fields: [receiptId], references: [id])
  supplierId         String
  supplier           FinanceParty       @relation("ThreeWayMatchSupplier", fields: [supplierId], references: [id])
  financeInvoiceId   String?
  financeInvoice     FinanceInvoice?    @relation("ThreeWayMatchInvoice", fields: [financeInvoiceId], references: [id])
  poTotalCents       Int                @default(0)
  receiptTotalCents  Int                @default(0)
  invoiceTotalCents  Int?
  priceVarianceCents Int                @default(0)
  invoiceVarianceCents Int?
  quantityVarianceQty Float             @default(0)
  toleranceBps       Int                @default(0)
  notes              String?
  classification     DataClassification @default(INTERNAL)
  approvedAt         DateTime?
  approvedById       String?
  approvedBy         User?              @relation("ThreeWayMatchApprovedBy", fields: [approvedById], references: [id])
  createdById        String?
  createdBy          User?              @relation("ThreeWayMatchCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, orderId])
}

// ---------------------------------------------------------------------------
// Phase 10 service
// ---------------------------------------------------------------------------

enum ServiceContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum ServiceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  CANCELLED
}

enum ServiceTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceVisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceContract {
  id                 String                @id @default(cuid())
  companyId          String                @default("cmp_comet")
  tenant             Company               @relation(fields: [companyId], references: [id])
  branchId           String?
  branch             Branch?               @relation(fields: [branchId], references: [id])
  number             String
  status             ServiceContractStatus @default(DRAFT)
  customerId         String
  customer           FinanceParty          @relation("ServiceContractCustomer", fields: [customerId], references: [id])
  startDate          String
  endDate            String?
  currency           String                @default("KES")
  monthlyFeeCents    Int                   @default(0)
  // Commercial SLA targets in whole hours; not statutory rates.
  responseSlaHours   Int
  resolutionSlaHours Int
  notes              String?
  classification     DataClassification    @default(INTERNAL)
  activatedAt        DateTime?
  suspendedAt        DateTime?
  cancelledAt        DateTime?
  createdById        String?
  createdBy          User?                 @relation("ServiceContractCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  lines   ServiceContractLine[]
  tickets ServiceTicket[]

  @@unique([companyId, number])
  @@index([companyId, status, startDate])
  @@index([companyId, customerId])
}

model ServiceContractLine {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  contractId       String
  contract         ServiceContract    @relation(fields: [contractId], references: [id])
  itemId           String?
  item             InventoryItem?     @relation("ServiceContractLineItem", fields: [itemId], references: [id])
  description      String
  coverageQty      Int                @default(1)
  unitPriceCents   Int                @default(0)
  position         Int                @default(0)
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("ServiceContractLineCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([contractId])
  @@index([companyId, itemId])
}

model ServiceTicket {
  id                String              @id @default(cuid())
  companyId         String              @default("cmp_comet")
  tenant            Company             @relation(fields: [companyId], references: [id])
  branchId          String?
  branch            Branch?             @relation(fields: [branchId], references: [id])
  number            String
  status            ServiceTicketStatus @default(OPEN)
  priority          ServiceTicketPriority @default(MEDIUM)
  contractId        String?
  contract          ServiceContract?    @relation(fields: [contractId], references: [id])
  customerId        String
  customer          FinanceParty        @relation("ServiceTicketCustomer", fields: [customerId], references: [id])
  subject           String
  description       String?
  openedAt          DateTime
  responseDueAt     DateTime
  resolutionDueAt   DateTime
  assignedToId      String?
  assignedTo        User?               @relation("ServiceTicketAssignee", fields: [assignedToId], references: [id])
  assignedAt        DateTime?
  respondedAt       DateTime?
  resolvedAt        DateTime?
  resolutionNotes   String?
  closedAt          DateTime?
  cancelledAt       DateTime?
  classification    DataClassification  @default(INTERNAL)
  createdById       String?
  createdBy         User?               @relation("ServiceTicketCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workOrders    WorkOrder[]
  visits        ServiceVisit[]
  partUsages    ServicePartUsage[]

  @@unique([companyId, number])
  @@index([companyId, status, priority])
  @@index([companyId, contractId])
  @@index([companyId, assignedToId])
}

model WorkOrder {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  number           String
  status           WorkOrderStatus    @default(DRAFT)
  ticketId         String
  ticket           ServiceTicket      @relation(fields: [ticketId], references: [id])
  technicianId     String?
  technician       User?              @relation("WorkOrderTechnician", fields: [technicianId], references: [id])
  summary          String
  labourCents      Int                @default(0)
  partsCents       Int                @default(0)
  totalCents       Int                @default(0)
  currency         String             @default("KES")
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  notes            String?
  classification   DataClassification @default(INTERNAL)
  // Optional finance link; service delegates all tax calculation to finance.
  financeInvoiceId String?
  financeInvoice   FinanceInvoice?    @relation("WorkOrderInvoice", fields: [financeInvoiceId], references: [id])
  createdById      String?
  createdBy        User?              @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  lines      WorkOrderLine[]
  visits     ServiceVisit[]
  partUsages ServicePartUsage[]

  @@unique([companyId, number])
  @@index([companyId, status, scheduledAt])
  @@index([companyId, ticketId])
}

model WorkOrderLine {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  workOrderId      String
  workOrder        WorkOrder          @relation(fields: [workOrderId], references: [id])
  itemId           String?
  item             InventoryItem?     @relation("WorkOrderLineItem", fields: [itemId], references: [id])
  description      String
  qty              Float
  unitPriceCents   Int
  totalCents       Int
  position         Int                @default(0)
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("WorkOrderLineCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([workOrderId])
  @@index([companyId, itemId])
}

model ServiceVisit {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  number           String
  status           ServiceVisitStatus @default(PLANNED)
  workOrderId      String
  workOrder        WorkOrder          @relation(fields: [workOrderId], references: [id])
  ticketId         String?
  ticket           ServiceTicket?     @relation(fields: [ticketId], references: [id])
  technicianId     String?
  technician       User?              @relation("ServiceVisitTechnician", fields: [technicianId], references: [id])
  plannedAt        DateTime
  checkInAt        DateTime?
  checkOutAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  notes            String?
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("ServiceVisitCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status, plannedAt])
  @@index([companyId, workOrderId])
}

model ServicePartUsage {
  id                  String             @id @default(cuid())
  companyId           String             @default("cmp_comet")
  tenant              Company            @relation(fields: [companyId], references: [id])
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id])
  workOrderId         String
  workOrder           WorkOrder          @relation(fields: [workOrderId], references: [id])
  ticketId            String?
  ticket              ServiceTicket?     @relation(fields: [ticketId], references: [id])
  itemId              String
  item                InventoryItem      @relation("ServicePartUsageItem", fields: [itemId], references: [id])
  warehouseId         String?
  warehouse           Warehouse?         @relation("ServicePartUsageWarehouse", fields: [warehouseId], references: [id])
  batchId             String?
  batch               InventoryBatch?    @relation("ServicePartUsageBatch", fields: [batchId], references: [id])
  qty                 Float
  unitCostCents       Int
  unitPriceCents      Int
  totalCents          Int
  inventoryIssued     Boolean            @default(false)
  manualIssueRequired Boolean            @default(true)
  issuedMovementId    String?
  notes               String?
  classification      DataClassification @default(INTERNAL)
  createdById         String?
  createdBy           User?              @relation("ServicePartUsageCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([workOrderId])
  @@index([companyId, itemId])
  @@index([companyId, inventoryIssued])
}

// ---------------------------------------------------------------------------
// Phase 11 HR
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
  CASUAL
}

enum EmploymentContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  COMPASSIONATE
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  TAKEN
  CANCELLED
}

enum PayrollRateKind {
  PAYE
  NSSF_EMPLOYEE
  NSSF_EMPLOYER
  SHIF
  HOUSING_LEVY
}

enum PayrollRateStatus {
  UNVERIFIED
  VERIFIED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  POSTED
  CANCELLED
}

/// Bank, account and tax-PIN values are stored encrypted at rest. The public
/// DTOs never expose them; ODPC sensitivity is documented in ADR-0016.
model Employee {
  id                    String             @id @default(cuid())
  companyId             String             @default("cmp_comet")
  tenant                Company            @relation(fields: [companyId], references: [id])
  branchId              String?
  branch                Branch?            @relation(fields: [branchId], references: [id])
  employeeNumber        String
  userId                String?
  user                  User?              @relation("EmployeeUser", fields: [userId], references: [id])
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  status                EmployeeStatus     @default(PROBATION)
  employmentType        EmploymentType     @default(PERMANENT)
  departmentId          String?
  department            Department?        @relation(fields: [departmentId], references: [id])
  jobTitleId            String?
  jobTitle              JobTitle?          @relation(fields: [jobTitleId], references: [id])
  hiredAt               DateTime
  terminatedAt          DateTime?
  annualLeaveBalanceDays Int                @default(0)
  bankNameEncrypted     String?
  bankAccountEncrypted  String?
  kraPinEncrypted       String?
  notes                 String?
  classification        DataClassification @default(CONFIDENTIAL)
  createdById           String?
  createdBy             User?              @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  contracts        EmploymentContract[]
  leaveRequests    LeaveRequest[]
  attendance       AttendanceRecord[]
  payrollLines     PayrollLine[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, status])
  @@index([companyId, branchId])
  @@index([companyId, departmentId])
}

model EmploymentContract {
  id               String                   @id @default(cuid())
  companyId        String                   @default("cmp_comet")
  tenant           Company                  @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?                  @relation(fields: [branchId], references: [id])
  employeeId       String
  employee         Employee                 @relation(fields: [employeeId], references: [id])
  number           String
  status           EmploymentContractStatus @default(DRAFT)
  employmentType   EmploymentType           @default(PERMANENT)
  startDate        DateTime
  endDate          DateTime?
  basicSalaryCents Int
  allowancesCents  Int                      @default(0)
  currency         String                   @default("KES")
  notes            String?
  classification   DataClassification       @default(CONFIDENTIAL)
  activatedAt      DateTime?
  terminatedAt     DateTime?
  cancelledAt      DateTime?
  createdById      String?
  createdBy        User?                    @relation("EmploymentContractCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([companyId, number])
  @@index([companyId, employeeId])
  @@index([companyId, status])
}

/// Versioned statutory rates. Rows are always created UNVERIFIED; only a
/// separate authorised verify action may make a row usable by calculations.
model PayrollRate {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  kind             PayrollRateKind
  rateBps          Int
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceReference  String
  verificationNote String?
  status           PayrollRateStatus  @default(UNVERIFIED)
  verifiedById     String?
  verifiedBy       User?              @relation("PayrollRateVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  classification   DataClassification @default(CONFIDENTIAL)
  createdById      String?
  createdBy        User?              @relation("PayrollRateCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([companyId, kind, effectiveFrom])
  @@index([companyId, kind, status, effectiveFrom])
}

model PayrollRun {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  number           String
  periodStart      DateTime
  periodEnd        DateTime
  employeeIds      String[]           @default([])
  status           PayrollRunStatus   @default(DRAFT)
  currency         String             @default("KES")
  grossCents       Int                @default(0)
  deductionsCents  Int                @default(0)
  employerCostCents Int               @default(0)
  netCents         Int                @default(0)
  calculatedAt     DateTime?
  approvedById     String?
  approvedBy       User?              @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  postedById       String?
  postedBy         User?              @relation("PayrollRunPostedBy", fields: [postedById], references: [id])
  postedAt         DateTime?
  financeJournalId String?
  financeJournal   FinanceJournal?    @relation(fields: [financeJournalId], references: [id])
  notes            String?
  classification   DataClassification @default(CONFIDENTIAL)
  createdById      String?
  createdBy        User?              @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  lines PayrollLine[]

  @@unique([companyId, number])
  @@index([companyId, status, periodStart])
}

model PayrollLine {
  id                  String             @id @default(cuid())
  companyId           String             @default("cmp_comet")
  tenant              Company            @relation(fields: [companyId], references: [id])
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id])
  runId               String
  run                 PayrollRun         @relation(fields: [runId], references: [id])
  employeeId          String
  employee            Employee           @relation(fields: [employeeId], references: [id])
  basicCents          Int
  allowancesCents     Int                @default(0)
  grossCents          Int
  payeCents           Int                @default(0)
  nssfEmployeeCents   Int                @default(0)
  nssfEmployerCents   Int                @default(0)
  shifCents           Int                @default(0)
  housingLevyCents    Int                @default(0)
  deductionsCents     Int                @default(0)
  netCents            Int
  // Snapshot of the VERIFIED row IDs and basis points used, for auditability.
  rateSnapshot        Json
  classification      DataClassification @default(CONFIDENTIAL)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([runId, employeeId])
  @@index([companyId, employeeId])
}

model LeaveRequest {
  id            String             @id @default(cuid())
  companyId     String             @default("cmp_comet")
  tenant        Company            @relation(fields: [companyId], references: [id])
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id])
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  number        String
  type          LeaveType
  status        LeaveStatus        @default(DRAFT)
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String
  approvedById  String?
  approvedBy    User?              @relation("LeaveRequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectedAt    DateTime?
  takenAt       DateTime?
  cancelledAt   DateTime?
  classification DataClassification @default(CONFIDENTIAL)
  createdById   String?
  createdBy     User?              @relation("LeaveRequestCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([companyId, number])
  @@index([companyId, employeeId, status])
  @@index([companyId, status, startDate])
}

model AttendanceRecord {
  id                  String             @id @default(cuid())
  companyId           String             @default("cmp_comet")
  tenant              Company            @relation(fields: [companyId], references: [id])
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id])
  employeeId          String
  employee            Employee           @relation(fields: [employeeId], references: [id])
  date                DateTime           @db.Date
  hoursWorkedMinutes  Int                @default(0)
  checkInAt           DateTime?
  checkOutAt          DateTime?
  notes               String?
  classification      DataClassification @default(CONFIDENTIAL)
  createdById         String?
  createdBy           User?              @relation("AttendanceRecordCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
}

// ---------------------------------------------------------------------------
// Phase 12 projects
//
// Projects, membership, tasks, milestones, time and finance budget links. Every
// table is tenant/branch scoped. Money is integer cents; hours are numeric and
// rounded once at the service boundary. Finance owns budget usage arithmetic and
// invoice tax arithmetic: this module keeps references and IDs only.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  MET
  MISSED
}

enum TimeEntryStatus {
  DRAFT
  APPROVED
  BILLED
  REJECTED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

model Project {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  number           String
  name             String
  description      String?
  status           ProjectStatus      @default(PLANNED)
  customerId       String?
  customer         FinanceParty?      @relation("ProjectCustomer", fields: [customerId], references: [id])
  salesOrderId     String?
  salesOrder       SalesOrder?        @relation("ProjectSalesOrder", fields: [salesOrderId], references: [id])
  // Finance owns the invoice; this is an opaque scalar reference only.
  financeInvoiceId String?
  financeInvoice   FinanceInvoice?    @relation("ProjectInvoice", fields: [financeInvoiceId], references: [id])
  budgetCents      Int                @default(0)
  currency         String             @default("KES")
  plannedStart     DateTime?
  plannedEnd       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  members     ProjectMember[]
  tasks       ProjectTask[]
  milestones  Milestone[]
  timeEntries TimeEntry[]
  budgetLinks ProjectBudgetLink[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, branchId])
  @@index([companyId, customerId])
}

model ProjectMember {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  userId         String
  user           User               @relation("ProjectMemberUser", fields: [userId], references: [id])
  role           ProjectMemberRole  @default(MEMBER)
  joinedAt       DateTime           @default(now())
  leftAt         DateTime?
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("ProjectMemberCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  timeEntries TimeEntry[] @relation("TimeEntryMember")

  @@unique([projectId, userId])
  @@index([companyId, projectId])
  @@index([companyId, userId])
}

model Milestone {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  number         String
  name           String
  description    String?
  status         MilestoneStatus    @default(PLANNED)
  dueAt          DateTime?
  metAt          DateTime?
  missedAt       DateTime?
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("MilestoneCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tasks ProjectTask[] @relation("TaskMilestone")

  @@unique([companyId, number])
  @@index([companyId, projectId])
  @@index([companyId, status])
}

model ProjectTask {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  number         String
  title          String
  description    String?
  status         ProjectTaskStatus  @default(TODO)
  assigneeId     String?
  assignee       User?              @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])
  milestoneId    String?
  milestone      Milestone?         @relation("TaskMilestone", fields: [milestoneId], references: [id])
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  position       Int                @default(0)
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  timeEntries TimeEntry[] @relation("TimeEntryTask")

  @@unique([companyId, number])
  @@index([companyId, projectId])
  @@index([companyId, assigneeId])
  @@index([companyId, status])
}

model TimeEntry {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  taskId         String?
  task           ProjectTask?       @relation("TimeEntryTask", fields: [taskId], references: [id])
  memberId       String?
  member         ProjectMember?     @relation("TimeEntryMember", fields: [memberId], references: [id])
  userId         String
  user           User               @relation("TimeEntryUser", fields: [userId], references: [id])
  number         String
  workDate       String
  // Numeric hours rounded to two decimals at the service boundary.
  hours          Float
  billable       Boolean            @default(false)
  hourlyRateCents Int               @default(0)
  amountCents    Int                @default(0)
  status         TimeEntryStatus    @default(DRAFT)
  approvedById   String?
  approvedBy     User?              @relation("TimeEntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedAt     DateTime?
  billedAt       DateTime?
  // Finance owns the invoice; this is an opaque scalar reference only.
  financeInvoiceId String?
  financeInvoice   FinanceInvoice?  @relation("TimeEntryInvoice", fields: [financeInvoiceId], references: [id])
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?            @relation("TimeEntryCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([companyId, number])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@index([companyId, workDate])
}

model ProjectBudgetLink {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  budgetId       String
  budget         FinanceBudget      @relation("ProjectBudgetLinkBudget", fields: [budgetId], references: [id])
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("ProjectBudgetLinkCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([projectId, budgetId])
  @@index([companyId, budgetId])
}
