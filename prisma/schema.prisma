// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Company {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  country   String        @default("KE")
  locale    String        @default("en-KE")
  currency  String        @default("KES")
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  settings           Setting[]
  users              User[]
  providers          Provider[]
  providerSchedules  ProviderSchedule[]
  appointments       Appointment[]
  inquiries          Inquiry[]
  testimonials       Testimonial[]
  documents          BusinessDocument[]
  branches           Branch[]
  departments        Department[]
  jobTitles          JobTitle[]
  groups             UserGroup[]
  groupMembers       GroupMember[]
  accessRoles        AccessRole[]
  permissions        Permission[]
  rolePermissions    RolePermission[]
  userRoles          UserRole[]
  sessions           Session[]
  mfaCredentials     MfaCredential[]
  recoveryCodes      RecoveryCode[]
  apiKeys            ApiKey[]
  inboxes            Inbox[]
  inboxMemberships   InboxMembership[]
  threads            Thread[]
  messages           Message[]
  messageRecipients  MessageRecipient[]
  messageEdits       MessageEdit[]
  reactions          MessageReaction[]
  attachments        Attachment[]
  channels           Channel[]
  channelMemberships ChannelMembership[]
  routingRules       RoutingRule[]
  retentionPolicies  RetentionPolicy[]
  legalHolds         LegalHold[]
  outboxEvents       OutboxEvent[]
  auditLogs          AuditLog[]
  passwordHistories  PasswordHistory[]
  fileObjects        FileObject[]
  fileVersions       FileVersion[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries NotificationDelivery[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances  WorkflowInstance[]
  workflowTasks      WorkflowTask[]
  searchDocuments    SearchDocument[]
  jobs               JobRecord[]
  financeAccounts    FinanceAccount[]
  financeParties     FinanceParty[]
  statutoryRates     StatutoryRate[]
  financeJournals    FinanceJournal[]
  financeJournalLines FinanceJournalLine[]
  financeInvoices    FinanceInvoice[]
  financeInvoiceLines FinanceInvoiceLine[]
  financePayments    FinancePayment[]
  financePaymentAllocations FinancePaymentAllocation[]
  financeBudgets     FinanceBudget[]
  financeBudgetLines FinanceBudgetLine[]
  etimsSubmissions   EtimsSubmission[]
  salesQuotes              SalesQuote[]
  salesQuoteLines          SalesQuoteLine[]
  salesOrders              SalesOrder[]
  salesOrderLines          SalesOrderLine[]
  deliveryNotes            DeliveryNote[]
  deliveryNoteLines        DeliveryNoteLine[]
  salesReturns             SalesReturn[]
  salesReturnLines         SalesReturnLine[]
  inventoryItems           InventoryItem[]
  warehouses               Warehouse[]
  inventoryBatches         InventoryBatch[]
  stockBalances            StockBalance[]
  stockMovements           StockMovement[]
  stockTransfers           StockTransfer[]
  stockTransferLines       StockTransferLine[]
  stockCounts              StockCount[]
  stockCountLines          StockCountLine[]
  // Phase 9 procurement
  purchaseRequisitions     PurchaseRequisition[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptLines        GoodsReceiptLine[]
  supplierReturns          SupplierReturn[]
  supplierReturnLines      SupplierReturnLine[]
  threeWayMatches          ThreeWayMatch[]
  // Phase 10 service
  serviceContracts         ServiceContract[]
  serviceContractLines     ServiceContractLine[]
  serviceTickets           ServiceTicket[]
  workOrders               WorkOrder[]
  workOrderLines           WorkOrderLine[]
  serviceVisits            ServiceVisit[]
  servicePartUsages        ServicePartUsage[]
  // Phase 11 HR
  employees                Employee[]
  employmentContracts      EmploymentContract[]
  payrollRates             PayrollRate[]
  payrollRuns              PayrollRun[]
  payrollLines             PayrollLine[]
  leaveRequests            LeaveRequest[]
  attendanceRecords        AttendanceRecord[]
  // Phase 12 projects
  projects                 Project[]
  projectMembers           ProjectMember[]
  projectTasks             ProjectTask[]
  milestones               Milestone[]
  timeEntries              TimeEntry[]
  projectBudgetLinks       ProjectBudgetLink[]
}

model Branch {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  code           String
  name           String
  type           BranchType         @default(OFFICE)
  address        String?
  city           String?
  phone          String?
  managerUserId  String?
  isActive       Boolean            @default(true)
  classification DataClassification @default(INTERNAL)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  users        User[]        @relation("UserBranch")
  inboxes      Inbox[]       @relation("InboxBranch")
  threads      Thread[]      @relation("ThreadBranch")
  messages     Message[]     @relation("MessageBranch")
  channels     Channel[]     @relation("ChannelBranch")
  routingRules RoutingRule[] @relation("RoutingBranch")
  files        FileObject[]  @relation("FileBranch")
  workflows    WorkflowInstance[] @relation("WorkflowBranch")
  financeAccounts    FinanceAccount[]
  financeParties     FinanceParty[]
  financeJournals    FinanceJournal[]
  financeInvoices    FinanceInvoice[]
  financePayments    FinancePayment[]
  financeBudgets     FinanceBudget[]
  etimsSubmissions   EtimsSubmission[]
  salesQuotes       SalesQuote[]
  salesQuoteLines   SalesQuoteLine[]
  salesOrders       SalesOrder[]
  salesOrderLines   SalesOrderLine[]
  deliveryNotes     DeliveryNote[]
  deliveryNoteLines DeliveryNoteLine[]
  salesReturns      SalesReturn[]
  salesReturnLines  SalesReturnLine[]
  inventoryItems           InventoryItem[]
  warehouses               Warehouse[]
  inventoryBatches         InventoryBatch[]
  stockBalances            StockBalance[]
  stockMovements           StockMovement[]
  stockTransfers           StockTransfer[]
  stockTransferLines       StockTransferLine[]
  stockCounts              StockCount[]
  stockCountLines          StockCountLine[]
  // Phase 9 procurement
  purchaseRequisitions     PurchaseRequisition[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptLines        GoodsReceiptLine[]
  supplierReturns          SupplierReturn[]
  supplierReturnLines      SupplierReturnLine[]
  threeWayMatches          ThreeWayMatch[]
  // Phase 10 service
  serviceContracts         ServiceContract[]
  serviceContractLines     ServiceContractLine[]
  serviceTickets           ServiceTicket[]
  workOrders               WorkOrder[]
  workOrderLines           WorkOrderLine[]
  serviceVisits            ServiceVisit[]
  servicePartUsages        ServicePartUsage[]
  // Phase 11 HR
  employees                Employee[]
  employmentContracts      EmploymentContract[]
  payrollRates             PayrollRate[]
  payrollRuns              PayrollRun[]
  payrollLines             PayrollLine[]
  leaveRequests            LeaveRequest[]
  attendanceRecords        AttendanceRecord[]
  // Phase 12 projects
  projects                 Project[]
  projectMembers           ProjectMember[]
  projectTasks             ProjectTask[]
  milestones               Milestone[]
  timeEntries              TimeEntry[]
  projectBudgetLinks       ProjectBudgetLink[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Department {
  id              String             @id @default(cuid())
  companyId       String             @default("cmp_comet")
  tenant          Company            @relation(fields: [companyId], references: [id])
  code            String
  name            String
  internalAddress String
  parentId        String?
  parent          Department?        @relation("DepartmentTree", fields: [parentId], references: [id])
  children        Department[]       @relation("DepartmentTree")
  headUserId      String?
  isActive        Boolean            @default(true)
  classification  DataClassification @default(INTERNAL)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  users             User[]            @relation("UserDepartment")
  inboxes           Inbox[]           @relation("InboxDepartment")
  channels          Channel[]         @relation("ChannelDepartment")
  retentionPolicies RetentionPolicy[]
  employees         Employee[]

  @@unique([companyId, code])
  @@unique([companyId, internalAddress])
}

model JobTitle {
  id        String    @id @default(cuid())
  companyId String    @default("cmp_comet")
  tenant    Company   @relation(fields: [companyId], references: [id])
  code      String
  name      String
  grade     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users     User[]     @relation("UserJobTitle")
  employees Employee[]

  @@unique([companyId, code])
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                  String             @id @default(cuid())
  companyId           String             @default("cmp_comet")
  tenant              Company            @relation(fields: [companyId], references: [id])
  // Phase 3: emails are unique per tenant because the same person may exist in
  // separate tenant databases. Auth resolution always includes companyId.
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  company             String?
  role                Role               @default(PATIENT)
  status              UserStatus         @default(ACTIVE)
  branchId            String?
  branch              Branch?            @relation("UserBranch", fields: [branchId], references: [id])
  departmentId        String?
  department          Department?        @relation("UserDepartment", fields: [departmentId], references: [id])
  jobTitleId          String?
  jobTitle            JobTitle?          @relation("UserJobTitle", fields: [jobTitleId], references: [id])
  managerId           String?
  manager             User?              @relation("UserManager", fields: [managerId], references: [id])
  reports             User[]             @relation("UserManager")
  locale              String             @default("en-KE")
  mfaEnabled          Boolean            @default(false)
  lastLoginAt         DateTime?
  resetTokenHash      String?
  resetTokenExp       DateTime?
  providerId          String?            @unique
  classification      DataClassification @default(CONFIDENTIAL)
  // Phase 3 identity fields.
  identityProvider    String             @default("local")
  externalId          String?
  failedLoginAttempts Int                @default(0)
  lastFailedLoginAt   DateTime?
  lockoutUntil        DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  provider             Provider?           @relation(fields: [providerId], references: [id])
  appointments         Appointment[]       @relation("PatientAppointments")
  documents            BusinessDocument[]
  sessions             Session[]
  mfaCredentials       MfaCredential[]
  recoveryCodes        RecoveryCode[]
  apiKeys              ApiKey[]
  passwordHistory      PasswordHistory[]
  groupMembers         GroupMember[]
  userRoles            UserRole[]
  inboxMemberships     InboxMembership[]
  ownedInboxes         Inbox[]             @relation("InboxOwner")
  threadsCreated       Thread[]            @relation("ThreadCreator")
  threadsAssigned      Thread[]            @relation("ThreadAssignee")
  messagesSent         Message[]           @relation("MessageSender")
  messageRecipients    MessageRecipient[]  @relation("RecipientUser")
  messageEdits         MessageEdit[]       @relation("EditEditor")
  reactions            MessageReaction[]
  attachments          Attachment[]        @relation("AttachmentUploader")
  channelsCreated      Channel[]           @relation("ChannelCreator")
  channelMemberships   ChannelMembership[]
  legalHolds           LegalHold[]         @relation("LegalHoldCreator")
  routingRulesAssigned RoutingRule[]       @relation("RoutingAssignee")
  auditLogs            AuditLog[]          @relation("AuditActor")
  filesUploaded        FileObject[]        @relation("FileUploader")
  fileVersionsCreated  FileVersion[]       @relation("FileVersionCreator")
  notifications        Notification[]      @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceUser")
  workflowDefinitions  WorkflowDefinition[] @relation("WorkflowDefinitionCreator")
  workflowRequests     WorkflowInstance[]  @relation("WorkflowRequester")
  workflowAssignments  WorkflowTask[]      @relation("WorkflowAssignee")
  workflowDelegationsFrom WorkflowTask[]   @relation("WorkflowDelegatedFrom")
  financeAccountsCreated   FinanceAccount[]  @relation("FinanceAccountCreatedBy")
  financePartiesCreated    FinanceParty[]    @relation("FinancePartyCreatedBy")
  statutoryRatesCreated    StatutoryRate[]   @relation("StatutoryRateCreatedBy")
  financeJournalsCreated   FinanceJournal[]  @relation("FinanceJournalCreatedBy")
  financeJournalsPosted    FinanceJournal[]  @relation("FinanceJournalPostedBy")
  financeInvoicesCreated   FinanceInvoice[]  @relation("FinanceInvoiceCreatedBy")
  financePaymentsCreated   FinancePayment[]  @relation("FinancePaymentCreatedBy")
  financeBudgetsCreated    FinanceBudget[]   @relation("FinanceBudgetCreatedBy")
  financeBudgetsApproved   FinanceBudget[]   @relation("FinanceBudgetApprovedBy")
  salesQuotesCreated      SalesQuote[]             @relation("SalesQuoteCreatedBy")
  salesOrdersCreated      SalesOrder[]             @relation("SalesOrderCreatedBy")
  deliveryNotesCreated    DeliveryNote[]           @relation("DeliveryNoteCreatedBy")
  salesReturnsCreated     SalesReturn[]            @relation("SalesReturnCreatedBy")
  inventoryItemsCreated   InventoryItem[]           @relation("InventoryItemCreatedBy")
  warehousesCreated       Warehouse[]               @relation("WarehouseCreatedBy")
  inventoryBatchesCreated InventoryBatch[]          @relation("InventoryBatchCreatedBy")
  stockBalancesCreated    StockBalance[]            @relation("StockBalanceCreatedBy")
  stockMovementsCreated   StockMovement[]           @relation("StockMovementCreatedBy")
  stockTransfersCreated   StockTransfer[]           @relation("StockTransferCreatedBy")
  stockTransfersApproved  StockTransfer[]           @relation("StockTransferApprovedBy")
  stockTransferLinesCreated StockTransferLine[]     @relation("StockTransferLineCreatedBy")
  stockCountsCreated      StockCount[]              @relation("StockCountCreatedBy")
  stockCountsApproved     StockCount[]              @relation("StockCountApprovedBy")
  stockCountLinesCreated  StockCountLine[]          @relation("StockCountLineCreatedBy")
  // Phase 9 procurement
  purchaseRequisitionsCreated     PurchaseRequisition[]     @relation("PurchaseRequisitionCreatedBy")
  purchaseRequisitionsApproved    PurchaseRequisition[]     @relation("PurchaseRequisitionApprovedBy")
  purchaseRequisitionLinesCreated PurchaseRequisitionLine[] @relation("PurchaseRequisitionLineCreatedBy")
  purchaseOrdersCreated           PurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved          PurchaseOrder[]           @relation("PurchaseOrderApprovedBy")
  purchaseOrderLinesCreated       PurchaseOrderLine[]       @relation("PurchaseOrderLineCreatedBy")
  goodsReceiptsCreated            GoodsReceipt[]            @relation("GoodsReceiptCreatedBy")
  goodsReceiptLinesCreated        GoodsReceiptLine[]        @relation("GoodsReceiptLineCreatedBy")
  supplierReturnsCreated          SupplierReturn[]          @relation("SupplierReturnCreatedBy")
  supplierReturnsApproved         SupplierReturn[]          @relation("SupplierReturnApprovedBy")
  supplierReturnLinesCreated      SupplierReturnLine[]      @relation("SupplierReturnLineCreatedBy")
  threeWayMatchesCreated          ThreeWayMatch[]           @relation("ThreeWayMatchCreatedBy")
  threeWayMatchesApproved         ThreeWayMatch[]           @relation("ThreeWayMatchApprovedBy")
  // Phase 10 service
  serviceContractsCreated     ServiceContract[]     @relation("ServiceContractCreatedBy")
  serviceContractLinesCreated ServiceContractLine[] @relation("ServiceContractLineCreatedBy")
  serviceTicketsCreated       ServiceTicket[]       @relation("ServiceTicketCreatedBy")
  serviceTicketsAssigned      ServiceTicket[]       @relation("ServiceTicketAssignee")
  workOrdersCreated           WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrdersAssigned          WorkOrder[]           @relation("WorkOrderTechnician")
  workOrderLinesCreated       WorkOrderLine[]       @relation("WorkOrderLineCreatedBy")
  serviceVisitsCreated        ServiceVisit[]        @relation("ServiceVisitCreatedBy")
  serviceVisitsAssigned       ServiceVisit[]        @relation("ServiceVisitTechnician")
  servicePartUsagesCreated    ServicePartUsage[]    @relation("ServicePartUsageCreatedBy")
  // Phase 11 HR
  hrEmployees                 Employee[]            @relation("EmployeeUser")
  hrEmployeesCreated          Employee[]            @relation("EmployeeCreatedBy")
  hrContractsCreated          EmploymentContract[]  @relation("EmploymentContractCreatedBy")
  hrPayrollRatesCreated       PayrollRate[]         @relation("PayrollRateCreatedBy")
  hrPayrollRatesVerified      PayrollRate[]         @relation("PayrollRateVerifiedBy")
  hrPayrollRunsCreated        PayrollRun[]          @relation("PayrollRunCreatedBy")
  hrPayrollRunsApproved       PayrollRun[]          @relation("PayrollRunApprovedBy")
  hrPayrollRunsPosted         PayrollRun[]          @relation("PayrollRunPostedBy")
  hrLeaveRequestsCreated      LeaveRequest[]        @relation("LeaveRequestCreatedBy")
  hrLeaveRequestsApproved     LeaveRequest[]        @relation("LeaveRequestApprovedBy")
  hrAttendanceRecordsCreated  AttendanceRecord[]    @relation("AttendanceRecordCreatedBy")
  // Phase 12 projects
  projectsCreated         Project[]           @relation("ProjectCreatedBy")
  projectMemberships      ProjectMember[]     @relation("ProjectMemberUser")
  projectMembershipsCreated ProjectMember[]   @relation("ProjectMemberCreatedBy")
  projectTasksAssigned    ProjectTask[]       @relation("ProjectTaskAssignee")
  projectTasksCreated     ProjectTask[]       @relation("ProjectTaskCreatedBy")
  milestonesCreated       Milestone[]         @relation("MilestoneCreatedBy")
  timeEntriesLogged       TimeEntry[]         @relation("TimeEntryUser")
  timeEntriesApproved     TimeEntry[]         @relation("TimeEntryApprovedBy")
  timeEntriesCreated      TimeEntry[]         @relation("TimeEntryCreatedBy")
  projectBudgetLinksCreated ProjectBudgetLink[] @relation("ProjectBudgetLinkCreatedBy")

  @@unique([companyId, email])
  @@unique([companyId, identityProvider, externalId])
  @@index([companyId, status])
  @@index([companyId, branchId])
}

/// Password reuse history. Hashes only; never plaintext or reset tokens.
model PasswordHistory {
  id        String   @id @default(cuid())
  companyId String   @default("cmp_comet")
  tenant    Company  @relation(fields: [companyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([companyId, userId, createdAt])
}

model UserGroup {
  id          String    @id @default(cuid())
  companyId   String    @default("cmp_comet")
  tenant      Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members GroupMember[]

  @@unique([companyId, name])
}

model GroupMember {
  id        String    @id @default(cuid())
  companyId String    @default("cmp_comet")
  tenant    Company   @relation(fields: [companyId], references: [id])
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
}

model AccessRole {
  id          String   @id @default(cuid())
  companyId   String   @default("cmp_comet")
  tenant      Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
}

model Permission {
  id          String   @id @default(cuid())
  companyId   String   @default("cmp_comet")
  tenant      Company  @relation(fields: [companyId], references: [id])
  code        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([companyId, code])
}

model RolePermission {
  id           String     @id @default(cuid())
  companyId    String     @default("cmp_comet")
  tenant       Company    @relation(fields: [companyId], references: [id])
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
