model FinanceAccount {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  code           String
  name           String
  type           FinanceAccountType
  normalBalance  FinanceAccountNormal
  systemCode     String?
  parentId       String?
