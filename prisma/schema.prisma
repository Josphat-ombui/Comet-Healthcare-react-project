  subtotal      Float          @default(0)
  tax           Float          @default(0)
  total         Float          @default(0)
  data          Json?
  company       Json?
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  financeInvoices FinanceInvoice[]

  @@index([companyId, kind])
  @@index([companyId, status])
  @@index([companyId, clientEmail])
}

// ---------------------------------------------------------------------------
// Phase 6 finance: chart of accounts, journals, invoices, payments, budgets
// ---------------------------------------------------------------------------

model FinanceAccount {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  code           String
  name           String
  type           FinanceAccountType
  normalBalance  FinanceAccountNormal
  systemCode     String?
  parentId       String?
  parent         FinanceAccount?    @relation("FinanceAccountTree", fields: [parentId], references: [id])
  children       FinanceAccount[]   @relation("FinanceAccountTree")
  currency       String             @default("KES")
  isActive       Boolean            @default(true)
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("FinanceAccountCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  journalLines FinanceJournalLine[]
  budgetLines  FinanceBudgetLine[]

  @@unique([companyId, code])
  @@unique([companyId, systemCode])
  @@index([companyId, type, isActive])
}

model FinanceParty {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  type             FinancePartyType
  name             String
  legalName        String?
  taxPinCiphertext String?
  email            String?
  phone            String?
  currency         String             @default("KES")
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("FinancePartyCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  invoices     FinanceInvoice[]
  payments     FinancePayment[]
  journalLines FinanceJournalLine[]
  salesQuotes   SalesQuote[]
  salesOrders   SalesOrder[]
  deliveryNotes DeliveryNote[]
  salesReturns  SalesReturn[]
  // Phase 9 procurement: suppliers are FinanceParty rows of type SUPPLIER.
  purchaseRequisitions PurchaseRequisition[] @relation("PurchaseRequisitionSupplier")
  purchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderSupplier")
  goodsReceipts        GoodsReceipt[]        @relation("GoodsReceiptSupplier")
  supplierReturns      SupplierReturn[]      @relation("SupplierReturnSupplier")
  threeWayMatches      ThreeWayMatch[]       @relation("ThreeWayMatchSupplier")
  // Phase 10 service: customers are FinanceParty rows of type CUSTOMER.
  serviceContracts     ServiceContract[]     @relation("ServiceContractCustomer")
  serviceTickets       ServiceTicket[]       @relation("ServiceTicketCustomer")
  // Phase 12 projects: customers are FinanceParty rows of type CUSTOMER.
  projects             Project[]             @relation("ProjectCustomer")

  @@index([companyId, type])
  @@index([companyId, name])
}

model StatutoryRate {
  id               String              @id @default(cuid())
  companyId        String              @default("cmp_comet")
  tenant           Company             @relation(fields: [companyId], references: [id])
  code             String
  kind             StatutoryRateKind
  label            String
  rateBps          Int
  effectiveFrom    String
  effectiveTo      String?
  sourceReference  String
  verificationNote String?
  verifiedBy       String?
  verifiedAt       DateTime?
  status           StatutoryRateStatus @default(UNVERIFIED)
  createdById      String?
  createdBy        User?               @relation("StatutoryRateCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  invoices     FinanceInvoice[]
  invoiceLines FinanceInvoiceLine[]

  @@unique([companyId, code, effectiveFrom])
  @@index([companyId, kind, status, effectiveFrom])
}

model FinanceJournal {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  number         String
  date           String
  description    String
  status         JournalStatus      @default(DRAFT)
  referenceType  String?
  referenceId    String?
  reversalOfId   String?
  reversalOf     FinanceJournal?    @relation("FinanceJournalReversal", fields: [reversalOfId], references: [id])
  reversals      FinanceJournal[]   @relation("FinanceJournalReversal")
  postedAt       DateTime?
  postedById     String?
  postedBy       User?              @relation("FinanceJournalPostedBy", fields: [postedById], references: [id])
  createdById    String?
  createdBy      User?              @relation("FinanceJournalCreatedBy", fields: [createdById], references: [id])
  classification DataClassification @default(INTERNAL)
  lines          FinanceJournalLine[]
  invoice        FinanceInvoice?
  payment        FinancePayment?
  payrollRuns    PayrollRun[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status, date])
}

model FinanceJournalLine {
  id          String         @id @default(cuid())
  companyId   String         @default("cmp_comet")
  tenant      Company        @relation(fields: [companyId], references: [id])
  journalId   String
  journal     FinanceJournal @relation(fields: [journalId], references: [id])
  accountId   String
  account     FinanceAccount @relation(fields: [accountId], references: [id])
  partyId     String?
  party       FinanceParty?  @relation(fields: [partyId], references: [id])
  debitCents  Int            @default(0)
  creditCents Int            @default(0)
  memo        String?
  position    Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([journalId])
  @@index([companyId, accountId])
}

model FinanceInvoice {
  id                 String                   @id @default(cuid())
  companyId          String                   @default("cmp_comet")
  tenant             Company                  @relation(fields: [companyId], references: [id])
  branchId           String?
  branch             Branch?                  @relation(fields: [branchId], references: [id])
  number             String
  direction          FinanceDocumentDirection
  type               FinanceDocumentType      @default(INVOICE)
  status             FinanceInvoiceStatus     @default(DRAFT)
  partyId            String
  party              FinanceParty             @relation(fields: [partyId], references: [id])
  issueDate          String
  dueDate            String?
  currency           String                   @default("KES")
  taxInclusive       Boolean                  @default(false)
  taxRateId          String?
  taxRate            StatutoryRate?           @relation(fields: [taxRateId], references: [id])
  subtotalCents      Int                      @default(0)
  taxCents           Int                      @default(0)
  totalCents         Int                      @default(0)
  paidCents          Int                      @default(0)
  balanceCents       Int                      @default(0)
  notes              String?
  classification     DataClassification       @default(INTERNAL)
  sourceInvoiceId    String?
  sourceInvoice      FinanceInvoice?          @relation("FinanceInvoiceCreditNote", fields: [sourceInvoiceId], references: [id])
  creditNotes        FinanceInvoice[]         @relation("FinanceInvoiceCreditNote")
  businessDocumentId String?
  businessDocument   BusinessDocument?        @relation(fields: [businessDocumentId], references: [id])
  journalId          String?                  @unique
  journal            FinanceJournal?          @relation(fields: [journalId], references: [id])
  createdById        String?
  createdBy          User?                    @relation("FinanceInvoiceCreatedBy", fields: [createdById], references: [id])
  issuedAt           DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  lines            FinanceInvoiceLine[]
  allocations      FinancePaymentAllocation[]
  etimsSubmissions EtimsSubmission[]
  // Phase 9: scalar links only; no finance journal/payment is created by procurement.
  purchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderInvoice")
  goodsReceipts   GoodsReceipt[]   @relation("GoodsReceiptInvoice")
  threeWayMatches ThreeWayMatch[]  @relation("ThreeWayMatchInvoice")
  // Phase 10: scalar link only; service invoices are created through finance.
  workOrders      WorkOrder[]      @relation("WorkOrderInvoice")
  // Phase 12: scalar links only; project invoices are created through finance.
  projects        Project[]        @relation("ProjectInvoice")
  timeEntries     TimeEntry[]      @relation("TimeEntryInvoice")

  @@unique([companyId, number])
  @@index([companyId, direction, status])
  @@index([companyId, partyId])
}

model FinanceInvoiceLine {
  id             String         @id @default(cuid())
  companyId      String         @default("cmp_comet")
  tenant         Company        @relation(fields: [companyId], references: [id])
  invoiceId      String
  invoice        FinanceInvoice @relation(fields: [invoiceId], references: [id])
  description    String
  qty            Float
  unitPriceCents Int
  taxRateId      String?
  taxRate        StatutoryRate? @relation(fields: [taxRateId], references: [id])
  netCents       Int            @default(0)
  taxCents       Int            @default(0)
  grossCents     Int            @default(0)
  position       Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([invoiceId])
}

model FinancePayment {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  number         String
  direction      PaymentDirection
  partyId        String
  party          FinanceParty       @relation(fields: [partyId], references: [id])
  method         PaymentMethod
  amountCents    Int
  currency       String             @default("KES")
  paidAt         DateTime?
  reference      String?
  status         PaymentStatus      @default(COMPLETED)
  journalId      String?            @unique
  journal        FinanceJournal?    @relation(fields: [journalId], references: [id])
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("FinancePaymentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  allocations FinancePaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId, direction])
  @@index([companyId, partyId])
}

model FinancePaymentAllocation {
  id          String         @id @default(cuid())
  companyId   String         @default("cmp_comet")
  tenant      Company        @relation(fields: [companyId], references: [id])
  paymentId   String
  payment     FinancePayment @relation(fields: [paymentId], references: [id])
  invoiceId   String
  invoice     FinanceInvoice @relation(fields: [invoiceId], references: [id])
  amountCents Int
  createdAt   DateTime       @default(now())

  @@unique([paymentId, invoiceId])
}

model FinanceBudget {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  code           String
  name           String
  period         BudgetPeriod
  startDate      String
  endDate        String
  status         BudgetStatus       @default(DRAFT)
  approvedById   String?
  approvedBy     User?              @relation("FinanceBudgetApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("FinanceBudgetCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines         FinanceBudgetLine[]
  // Phase 12: usage is computed by the finance helper, never duplicated here.
  projectLinks  ProjectBudgetLink[] @relation("ProjectBudgetLinkBudget")

  @@unique([companyId, code])
}

model FinanceBudgetLine {
  id          String         @id @default(cuid())
  companyId   String         @default("cmp_comet")
  tenant      Company        @relation(fields: [companyId], references: [id])
  budgetId    String
  budget      FinanceBudget  @relation(fields: [budgetId], references: [id])
  accountId   String
  account     FinanceAccount @relation(fields: [accountId], references: [id])
  amountCents Int
  createdAt   DateTime       @default(now())

  @@unique([budgetId, accountId])
}

model EtimsSubmission {
  id                String         @id @default(cuid())
  companyId         String         @default("cmp_comet")
  tenant            Company        @relation(fields: [companyId], references: [id])
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  invoiceId         String
  invoice           FinanceInvoice @relation(fields: [invoiceId], references: [id])
  payloadVersion    String
  status            EtimsStatus    @default(QUEUED)
  provider          String?
  externalReference String?
  attempts          Int            @default(0)
  lastError         String?
  payload           Json?
  queuedAt          DateTime       @default(now())
  submittedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([companyId, invoiceId])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Phase 7 sales
//
// Header documents carry their own tenant/branch scope, customer party link,
// number, status and integer-cent totals. `taxRateId` is an intended statutory
// rate reference only: no rate value is copied into these rows. Invoice creation
// resolves a VERIFIED finance rate at issue time instead.
// ---------------------------------------------------------------------------

model SalesQuote {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  number         String
  status         SalesQuoteStatus   @default(DRAFT)
  partyId        String
  party          FinanceParty       @relation(fields: [partyId], references: [id])
  quoteDate      String
  validUntil     String?
  currency       String             @default("KES")
  // Intended statutory rate reference. The rate is never hardcoded or copied;
  // only finance issueInvoice applies a VERIFIED rate to an issued invoice.
  taxRateId      String?
  subtotalCents  Int                @default(0)
  taxCents       Int                @default(0)
  totalCents     Int                @default(0)
  notes          String?
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("SalesQuoteCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines SalesQuoteLine[]

  @@unique([companyId, number])
  @@index([companyId, status, quoteDate])
  @@index([companyId, partyId])
}

model SalesQuoteLine {
  id             String     @id @default(cuid())
  companyId      String     @default("cmp_comet")
  tenant         Company    @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?    @relation(fields: [branchId], references: [id])
  quoteId        String
  quote          SalesQuote @relation(fields: [quoteId], references: [id])
  description    String
  qty            Float
  unitPriceCents Int
  netCents       Int        @default(0)
  taxCents       Int        @default(0)
  grossCents     Int        @default(0)
  position       Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([quoteId])
  @@index([companyId])
}

model SalesOrder {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  number           String
  status           SalesOrderStatus   @default(DRAFT)
  partyId          String
  party            FinanceParty       @relation(fields: [partyId], references: [id])
  quoteId          String?
  orderDate        String
  requestedDate    String?
  currency         String             @default("KES")
  taxRateId        String?
  subtotalCents    Int                @default(0)
  taxCents         Int                @default(0)
  totalCents       Int                @default(0)
  notes            String?
  classification   DataClassification @default(INTERNAL)
  // Plain scalar link: finance owns the invoice relation; this avoids a
  // circular Prisma relation between sales and finance.
  financeInvoiceId String?
  createdById      String?
  createdBy        User?              @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  lines    SalesOrderLine[]
  // Phase 12: scalar link only; the project references a confirmed sales order.
  projects Project[]       @relation("ProjectSalesOrder")

  @@unique([companyId, number])
  @@index([companyId, status, orderDate])
  @@index([companyId, partyId])
}

model SalesOrderLine {
  id             String     @id @default(cuid())
  companyId      String     @default("cmp_comet")
  tenant         Company    @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?    @relation(fields: [branchId], references: [id])
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id])
  description    String
  qty            Float
  unitPriceCents Int
  netCents       Int        @default(0)
  taxCents       Int        @default(0)
  grossCents     Int        @default(0)
  position       Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([orderId])
  @@index([companyId])
}

model DeliveryNote {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  number         String
  status         DeliveryNoteStatus @default(DRAFT)
  partyId        String
  party          FinanceParty       @relation(fields: [partyId], references: [id])
  orderId        String?
  deliveryDate   String
  currency       String             @default("KES")
  subtotalCents  Int                @default(0)
  taxCents       Int                @default(0)
  totalCents     Int                @default(0)
  notes          String?
  classification DataClassification @default(INTERNAL)
  issuedAt       DateTime?
  deliveredAt    DateTime?
  createdById    String?
  createdBy      User?              @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines DeliveryNoteLine[]

  @@unique([companyId, number])
  @@index([companyId, status, deliveryDate])
  @@index([companyId, partyId])
}

model DeliveryNoteLine {
  id             String       @id @default(cuid())
  companyId      String       @default("cmp_comet")
  tenant         Company      @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id])
  description    String
  qty            Float
  unitPriceCents Int
  netCents       Int          @default(0)
  taxCents       Int          @default(0)
  grossCents     Int          @default(0)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([deliveryNoteId])
  @@index([companyId])
}

model SalesReturn {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  number         String
  status         SalesReturnStatus  @default(DRAFT)
  partyId        String
  party          FinanceParty       @relation(fields: [partyId], references: [id])
  orderId        String?
  deliveryNoteId String?
  returnDate     String
  reason         String?
  currency       String             @default("KES")
  subtotalCents  Int                @default(0)
  taxCents       Int                @default(0)
  totalCents     Int                @default(0)
  classification DataClassification @default(INTERNAL)
  approvedAt     DateTime?
  receivedAt     DateTime?
  createdById    String?
  createdBy      User?              @relation("SalesReturnCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines SalesReturnLine[]

  @@unique([companyId, number])
  @@index([companyId, status, returnDate])
  @@index([companyId, partyId])
}

model SalesReturnLine {
  id             String      @id @default(cuid())
  companyId      String      @default("cmp_comet")
  tenant         Company     @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])
  returnId       String
  returnRecord   SalesReturn @relation(fields: [returnId], references: [id])
  description    String
  qty            Float
  unitPriceCents Int
  netCents       Int         @default(0)
  taxCents       Int         @default(0)
  grossCents     Int         @default(0)
  position       Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([returnId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Phase 8 inventory
//
// Stock is valued with a weighted-average unit cost in integer cents. Balances
// are unique per company + item + warehouse + batch; a NULL batch represents
// unbatched stock. Quantities are rounded to three decimals at the service
// boundary. All tables carry tenant/branch scope and RLS policies. Events and
// audit metadata carry IDs only — never quantities, costs or free text.
// ---------------------------------------------------------------------------

model InventoryItem {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  code             String
  name             String
  type             InventoryItemType
  unit             InventoryUnit      @default(EA)
  standardCostCents Int               @default(0)
  reorderLevel     Float              @default(0)
  trackBatches     Boolean            @default(true)
  isActive         Boolean            @default(true)
  description      String?
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("InventoryItemCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  batches         InventoryBatch[]
  balances        StockBalance[]
  movements       StockMovement[]
  transferLines   StockTransferLine[]
  countLines      StockCountLine[]
  // Phase 9 procurement
  purchaseRequisitionLines PurchaseRequisitionLine[] @relation("PurchaseRequisitionLineItem")
  purchaseOrderLines       PurchaseOrderLine[]       @relation("PurchaseOrderLineItem")
  goodsReceiptLines        GoodsReceiptLine[]        @relation("GoodsReceiptLineItem")
  supplierReturnLines      SupplierReturnLine[]      @relation("SupplierReturnLineItem")
  // Phase 10 service
  serviceContractLines     ServiceContractLine[]     @relation("ServiceContractLineItem")
  workOrderLines           WorkOrderLine[]           @relation("WorkOrderLineItem")
  servicePartUsages        ServicePartUsage[]        @relation("ServicePartUsageItem")

  @@unique([companyId, code])
  @@index([companyId, type, isActive])
}

model Warehouse {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  code           String
  name           String
  location       String?
  isActive       Boolean            @default(true)
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  balances       StockBalance[]
  movementsOut   StockMovement[]    @relation("StockMovementWarehouse")
  transfersFrom  StockTransfer[]    @relation("StockTransferSource")
  transfersTo    StockTransfer[]    @relation("StockTransferDestination")
  counts         StockCount[]
  // Phase 9 procurement
  purchaseRequisitionLines PurchaseRequisitionLine[] @relation("PurchaseRequisitionLineWarehouse")
  purchaseOrderLines       PurchaseOrderLine[]       @relation("PurchaseOrderLineWarehouse")
  goodsReceiptLines        GoodsReceiptLine[]        @relation("GoodsReceiptLineWarehouse")
  supplierReturnLines      SupplierReturnLine[]      @relation("SupplierReturnLineWarehouse")
  // Phase 10 service
  servicePartUsages        ServicePartUsage[]        @relation("ServicePartUsageWarehouse")

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model InventoryBatch {
  id               String             @id @default(cuid())
  companyId        String             @default("cmp_comet")
  tenant           Company            @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?            @relation(fields: [branchId], references: [id])
  itemId           String
  item             InventoryItem      @relation(fields: [itemId], references: [id])
  batchNumber      String
  status           BatchStatus        @default(QUARANTINE)
  unitCostCents    Int                @default(0)
  manufactureDate  String?
  expiryDate       String?
  classification   DataClassification @default(INTERNAL)
  createdById      String?
  createdBy        User?              @relation("InventoryBatchCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  balances        StockBalance[]
  movements       StockMovement[]
  transferLines   StockTransferLine[]
  countLines      StockCountLine[]
  // Phase 9 procurement
  goodsReceiptLines   GoodsReceiptLine[]   @relation("GoodsReceiptLineBatch")
  supplierReturnLines SupplierReturnLine[] @relation("SupplierReturnLineBatch")
  // Phase 10 service
  servicePartUsages   ServicePartUsage[]   @relation("ServicePartUsageBatch")

  @@unique([companyId, itemId, batchNumber])
  @@index([companyId, status])
  @@index([companyId, expiryDate])
}

