// Comet Healthcare — PostgreSQL 16 enterprise schema (Phase 2)
//
// Prisma owns schema shape and application CRUD. Raw SQL migrations in
// prisma/migrations own RLS policies, roles, grants, and audit-immutability
// rules. Every business table carries company_id; addressable tables also
// carry branch_id. Restricted values are encrypted in the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BranchType {
  HQ
  PLANT
  WAREHOUSE
  WORKSHOP
  SHOWROOM
  OFFICE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum GroupRole {
  OWNER
  MANAGER
  MEMBER
}

enum MfaType {
  TOTP
  WEBAUTHN
  SMS
}

enum InboxKind {
  PERSONAL
  DEPARTMENT
  ROLE
  BRANCH
  SHARED
}

enum InboxMemberRole {
  MANAGER
  AGENT
  MEMBER
}

enum ThreadStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ThreadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageVisibility {
  RECIPIENT
  INTERNAL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  READ
  FAILED
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum ChannelMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  QUARANTINED
  SKIPPED
}

enum RoutingMatchType {
  KEYWORD
  SENDER_TYPE
  FORM_TYPE
}

enum LegalHoldStatus {
  ACTIVE
  RELEASED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Existing public-site enums are retained for backward compatibility.
enum Role {
  PATIENT
  PROVIDER
  ADMIN
  STAFF
  MANAGER
  COMPLIANCE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InquiryKind {
  CONTACT
  CATALOG
  CDMO
}

enum InquiryStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum DocumentKind {
  QUOTATION
  PROFORMA_INVOICE
  INVOICE
  ORDER_CONFIRMATION
  CDMO_SLA
  NDA
  COA
}

enum DocumentStatus {
  DRAFT
  ISSUED
  VOID
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Company {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  country   String        @default("KE")
  locale    String        @default("en-KE")
  currency  String        @default("KES")
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  settings           Setting[]
  users              User[]
  providers          Provider[]
  providerSchedules  ProviderSchedule[]
  appointments       Appointment[]
  inquiries          Inquiry[]
  testimonials       Testimonial[]
  documents          BusinessDocument[]
  branches           Branch[]
  departments        Department[]
  jobTitles          JobTitle[]
  groups             UserGroup[]
  groupMembers       GroupMember[]
  accessRoles        AccessRole[]
  permissions        Permission[]
  rolePermissions    RolePermission[]
  userRoles          UserRole[]
  sessions           Session[]
  mfaCredentials     MfaCredential[]
  recoveryCodes      RecoveryCode[]
  apiKeys            ApiKey[]
  inboxes            Inbox[]
  inboxMemberships   InboxMembership[]
  threads            Thread[]
  messages           Message[]
  messageRecipients  MessageRecipient[]
  messageEdits       MessageEdit[]
  reactions          MessageReaction[]
  attachments        Attachment[]
  channels           Channel[]
  channelMemberships ChannelMembership[]
  routingRules       RoutingRule[]
  retentionPolicies  RetentionPolicy[]
  legalHolds         LegalHold[]
  outboxEvents       OutboxEvent[]
  auditLogs          AuditLog[]
  passwordHistories  PasswordHistory[]
}

model Branch {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  code           String
  name           String
  type           BranchType         @default(OFFICE)
  address        String?
  city           String?
  phone          String?
  managerUserId  String?
  isActive       Boolean            @default(true)
  classification DataClassification @default(INTERNAL)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  users        User[]        @relation("UserBranch")
  inboxes      Inbox[]       @relation("InboxBranch")
  threads      Thread[]      @relation("ThreadBranch")
  messages     Message[]     @relation("MessageBranch")
  channels     Channel[]     @relation("ChannelBranch")
  routingRules RoutingRule[] @relation("RoutingBranch")

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Department {
  id              String             @id @default(cuid())
  companyId       String             @default("cmp_comet")
  tenant          Company            @relation(fields: [companyId], references: [id])
  code            String
  name            String
  internalAddress String
  parentId        String?
  parent          Department?        @relation("DepartmentTree", fields: [parentId], references: [id])
  children        Department[]       @relation("DepartmentTree")
  headUserId      String?
  isActive        Boolean            @default(true)
  classification  DataClassification @default(INTERNAL)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  users             User[]            @relation("UserDepartment")
  inboxes           Inbox[]           @relation("InboxDepartment")
  channels          Channel[]         @relation("ChannelDepartment")
  retentionPolicies RetentionPolicy[]

  @@unique([companyId, code])
  @@unique([companyId, internalAddress])
}

model JobTitle {
  id        String    @id @default(cuid())
  companyId String    @default("cmp_comet")
  tenant    Company   @relation(fields: [companyId], references: [id])
  code      String
  name      String
  grade     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[] @relation("UserJobTitle")

  @@unique([companyId, code])
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                  String             @id @default(cuid())
  companyId           String             @default("cmp_comet")
  tenant              Company            @relation(fields: [companyId], references: [id])
  // Phase 3: emails are unique per tenant because the same person may exist in
  // separate tenant databases. Auth resolution always includes companyId.
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  company             String?
  role                Role               @default(PATIENT)
  status              UserStatus         @default(ACTIVE)
  branchId            String?
  branch              Branch?            @relation("UserBranch", fields: [branchId], references: [id])
  departmentId        String?
  department          Department?        @relation("UserDepartment", fields: [departmentId], references: [id])
  jobTitleId          String?
  jobTitle            JobTitle?          @relation("UserJobTitle", fields: [jobTitleId], references: [id])
  managerId           String?
  manager             User?              @relation("UserManager", fields: [managerId], references: [id])
  reports             User[]             @relation("UserManager")
  locale              String             @default("en-KE")
  mfaEnabled          Boolean            @default(false)
  lastLoginAt         DateTime?
  resetTokenHash      String?
  resetTokenExp       DateTime?
  providerId          String?            @unique
  classification      DataClassification @default(CONFIDENTIAL)
  // Phase 3 identity fields.
  identityProvider    String             @default("local")
  externalId          String?
  failedLoginAttempts Int                @default(0)
  lastFailedLoginAt   DateTime?
  lockoutUntil        DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  provider             Provider?           @relation(fields: [providerId], references: [id])
  appointments         Appointment[]       @relation("PatientAppointments")
  documents            BusinessDocument[]
  sessions             Session[]
  mfaCredentials       MfaCredential[]
  recoveryCodes        RecoveryCode[]
  apiKeys              ApiKey[]
  passwordHistory      PasswordHistory[]
  groupMembers         GroupMember[]
  userRoles            UserRole[]
  inboxMemberships     InboxMembership[]
  ownedInboxes         Inbox[]             @relation("InboxOwner")
  threadsCreated       Thread[]            @relation("ThreadCreator")
  threadsAssigned      Thread[]            @relation("ThreadAssignee")
  messagesSent         Message[]           @relation("MessageSender")
  messageRecipients    MessageRecipient[]  @relation("RecipientUser")
  messageEdits         MessageEdit[]       @relation("EditEditor")
  reactions            MessageReaction[]
  attachments          Attachment[]        @relation("AttachmentUploader")
  channelsCreated      Channel[]           @relation("ChannelCreator")
  channelMemberships   ChannelMembership[]
  legalHolds           LegalHold[]         @relation("LegalHoldCreator")
  routingRulesAssigned RoutingRule[]       @relation("RoutingAssignee")
  auditLogs            AuditLog[]          @relation("AuditActor")

  @@unique([companyId, email])
  @@unique([companyId, identityProvider, externalId])
  @@index([companyId, status])
  @@index([companyId, branchId])
}

/// Password reuse history. Hashes only; never plaintext or reset tokens.
model PasswordHistory {
  id        String   @id @default(cuid())
  companyId String   @default("cmp_comet")
  tenant    Company  @relation(fields: [companyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([companyId, userId, createdAt])
}

model UserGroup {
  id          String    @id @default(cuid())
  companyId   String    @default("cmp_comet")
  tenant      Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members GroupMember[]

  @@unique([companyId, name])
}

model GroupMember {
  id        String    @id @default(cuid())
  companyId String    @default("cmp_comet")
  tenant    Company   @relation(fields: [companyId], references: [id])
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
}

model AccessRole {
  id          String   @id @default(cuid())
  companyId   String   @default("cmp_comet")
  tenant      Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
}

model Permission {
  id          String   @id @default(cuid())
  companyId   String   @default("cmp_comet")
  tenant      Company  @relation(fields: [companyId], references: [id])
  code        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([companyId, code])
}

model RolePermission {
  id           String     @id @default(cuid())
  companyId    String     @default("cmp_comet")
  tenant       Company    @relation(fields: [companyId], references: [id])
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id                String     @id @default(cuid())
  companyId         String     @default("cmp_comet")
  tenant            Company    @relation(fields: [companyId], references: [id])
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId            String
  role              AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeBranchId     String?
  scopeDepartmentId String?
  grantedAt         DateTime   @default(now())
  grantedBy         String?

  @@unique([userId, roleId, scopeBranchId, scopeDepartmentId])
}

model Session {
  id               String    @id @default(cuid())
  companyId        String    @default("cmp_comet")
  tenant           Company   @relation(fields: [companyId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([companyId, userId])
}

model MfaCredential {
  id              String    @id @default(cuid())
  companyId       String    @default("cmp_comet")
  tenant          Company   @relation(fields: [companyId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            MfaType
  secretEncrypted String
  enabled         Boolean   @default(false)
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, type])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  companyId String    @default("cmp_comet")
  tenant    Company   @relation(fields: [companyId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String    @default("cmp_comet")
  tenant     Company   @relation(fields: [companyId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  name       String
  keyPrefix  String
  keyHash    String    @unique
  scopes     Json
  rateLimit  Int       @default(60)
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId, keyPrefix])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model RetentionPolicy {
  id              String      @id @default(cuid())
  companyId       String      @default("cmp_comet")
  tenant          Company     @relation(fields: [companyId], references: [id])
  name            String
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  retentionDays   Int         @default(365)
  action          String      @default("ARCHIVE")
  legalHoldPauses Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  inboxes Inbox[]

  @@unique([companyId, name])
}

model LegalHold {
  id              String          @id @default(cuid())
  companyId       String          @default("cmp_comet")
  tenant          Company         @relation(fields: [companyId], references: [id])
  name            String
  scopeType       String
  scopeId         String?
  status          LegalHoldStatus @default(ACTIVE)
  reasonEncrypted String
  createdById     String?
  createdBy       User?           @relation("LegalHoldCreator", fields: [createdById], references: [id])
  releasedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([companyId, status])
}

model Inbox {
  id                String             @id @default(cuid())
  companyId         String             @default("cmp_comet")
  tenant            Company            @relation(fields: [companyId], references: [id])
  branchId          String?
  branch            Branch?            @relation("InboxBranch", fields: [branchId], references: [id])
  departmentId      String?
  department        Department?        @relation("InboxDepartment", fields: [departmentId], references: [id])
  ownerUserId       String?
  owner             User?              @relation("InboxOwner", fields: [ownerUserId], references: [id])
  retentionPolicyId String?
  retentionPolicy   RetentionPolicy?   @relation(fields: [retentionPolicyId], references: [id])
  kind              InboxKind
  code              String
  name              String
  internalAddress   String
  description       String?
  classification    DataClassification @default(INTERNAL)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  memberships  InboxMembership[]
  threads      Thread[]
  sentMessages Message[]          @relation("MessageSenderInbox")
  recipients   MessageRecipient[] @relation("RecipientInbox")
  routingRules RoutingRule[]

  @@unique([companyId, internalAddress])
  @@unique([companyId, code])
  @@index([companyId, kind])
}

model InboxMembership {
  id        String          @id @default(cuid())
  companyId String          @default("cmp_comet")
  tenant    Company         @relation(fields: [companyId], references: [id])
  inboxId   String
  inbox     Inbox           @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      InboxMemberRole @default(MEMBER)
  canAssign Boolean         @default(false)
  notify    Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@unique([inboxId, userId])
  @@index([companyId, userId])
}

model Thread {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation("ThreadBranch", fields: [branchId], references: [id])
  inboxId        String?
  inbox          Inbox?             @relation(fields: [inboxId], references: [id])
  subject        String
  status         ThreadStatus       @default(OPEN)
  priority       ThreadPriority     @default(NORMAL)
  dueDate        DateTime?
  assignedToId   String?
  assignedTo     User?              @relation("ThreadAssignee", fields: [assignedToId], references: [id])
  createdById    String?
  createdBy      User?              @relation("ThreadCreator", fields: [createdById], references: [id])
  lastMessageAt  DateTime?
  snoozedUntil   DateTime?
  archived       Boolean            @default(false)
  classification DataClassification @default(INTERNAL)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  messages Message[]

  @@index([companyId, inboxId, lastMessageAt])
  @@index([companyId, assignedToId, status])
}

model Message {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation("MessageBranch", fields: [branchId], references: [id])
  threadId       String
  thread         Thread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?              @relation("MessageSender", fields: [senderId], references: [id])
  senderInboxId  String?
  senderInbox    Inbox?             @relation("MessageSenderInbox", fields: [senderInboxId], references: [id])
  body           String
  bodyFormat     String             @default("MARKDOWN")
  visibility     MessageVisibility  @default(RECIPIENT)
  priority       ThreadPriority     @default(NORMAL)
  idempotencyKey String             @unique
  recalledAt     DateTime?
  recalledBy     String?
  editedAt       DateTime?
  classification DataClassification @default(INTERNAL)
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?

  recipients  MessageRecipient[]
  edits       MessageEdit[]
  reactions   MessageReaction[]
  attachments Attachment[]

  @@index([companyId, threadId, createdAt])
  @@index([companyId, createdAt])
}

model MessageRecipient {
  id           String         @id @default(cuid())
  companyId    String         @default("cmp_comet")
  tenant       Company        @relation(fields: [companyId], references: [id])
  messageId    String
  message      Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation("RecipientUser", fields: [userId], references: [id])
  inboxId      String?
  inbox        Inbox?         @relation("RecipientInbox", fields: [inboxId], references: [id])
  departmentId String?
  roleId       String?
  branchId     String?
  isCc         Boolean        @default(false)
  isBcc        Boolean        @default(false)
  status       DeliveryStatus @default(PENDING)
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime       @default(now())

  @@index([companyId, userId, status])
  @@index([companyId, inboxId, status])
}

model MessageEdit {
  id           String   @id @default(cuid())
  companyId    String   @default("cmp_comet")
  tenant       Company  @relation(fields: [companyId], references: [id])
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editedById   String
  editedBy     User     @relation("EditEditor", fields: [editedById], references: [id])
  previousBody String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([companyId, messageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  companyId String   @default("cmp_comet")
  tenant    Company  @relation(fields: [companyId], references: [id])
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Attachment {
  id             String               @id @default(cuid())
  companyId      String               @default("cmp_comet")
  tenant         Company              @relation(fields: [companyId], references: [id])
  messageId      String?
  message        Message?             @relation(fields: [messageId], references: [id])
  uploadedById   String
  uploadedBy     User                 @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  objectKey      String
  fileName       String
  mimeType       String
  size           Int
  checksum       String?
  version        Int                  @default(1)
  classification DataClassification   @default(INTERNAL)
  scanStatus     AttachmentScanStatus @default(PENDING)
  previewUrl     String?
  createdAt      DateTime             @default(now())
  deletedAt      DateTime?

  @@index([companyId, messageId])
  @@index([companyId, scanStatus])
}

model Channel {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation("ChannelBranch", fields: [branchId], references: [id])
  departmentId   String?
  department     Department?        @relation("ChannelDepartment", fields: [departmentId], references: [id])
  createdById    String?
  createdBy      User?              @relation("ChannelCreator", fields: [createdById], references: [id])
  name           String
  description    String?
  visibility     ChannelVisibility  @default(PUBLIC)
  classification DataClassification @default(INTERNAL)
  isArchived     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  members ChannelMembership[]

  @@unique([companyId, name])
}

model ChannelMembership {
  id        String            @id @default(cuid())
  companyId String            @default("cmp_comet")
  tenant    Company           @relation(fields: [companyId], references: [id])
  channelId String
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChannelMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  @@unique([channelId, userId])
}

model RoutingRule {
  id            String           @id @default(cuid())
  companyId     String           @default("cmp_comet")
  tenant        Company          @relation(fields: [companyId], references: [id])
  branchId      String?
  branch        Branch?          @relation("RoutingBranch", fields: [branchId], references: [id])
  targetInboxId String
  targetInbox   Inbox            @relation(fields: [targetInboxId], references: [id])
  assignToId    String?
  assignTo      User?            @relation("RoutingAssignee", fields: [assignToId], references: [id])
  name          String
  priority      Int              @default(100)
  matchType     RoutingMatchType
  matchValue    String
  isEnabled     Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([companyId, isEnabled, priority])
}

// ---------------------------------------------------------------------------
// Platform: event outbox and immutable audit
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String       @id @default(cuid())
  companyId     String       @default("cmp_comet")
  tenant        Company      @relation(fields: [companyId], references: [id])
  eventType     String
  version       Int          @default(1)
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String
  branchId      String?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([companyId, status, availableAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  companyId     String   @default("cmp_comet")
  tenant        Company  @relation(fields: [companyId], references: [id])
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id])
  action        String
  resourceType  String
  resourceId    String
  metadata      Json?
  correlationId String
  previousHash  String
  hash          String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, actorId])
}

// ---------------------------------------------------------------------------
// Existing public-site models (migrated from SQLite, now tenant-scoped)
// ---------------------------------------------------------------------------

model Setting {
  key       String  @id
  companyId String  @default("cmp_comet")
  tenant    Company @relation(fields: [companyId], references: [id])
  value     Json?
}

model Provider {
  id              String    @id @default(cuid())
  companyId       String    @default("cmp_comet")
  tenant          Company   @relation(fields: [companyId], references: [id])
  slug            String    @unique
  user            User?
  name            String
  title           String
  specialty       String
  location        String
  bio             String
  image           String
  yearsExperience Int
  rating          Decimal   @default(4.8)
  reviewsCount    Int       @default(0)
  phone           String?
  email           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  schedules    ProviderSchedule[]
  appointments Appointment[]

  @@index([companyId, active])
}

model ProviderSchedule {
  id          String   @id @default(cuid())
  companyId   String   @default("cmp_comet")
  tenant      Company  @relation(fields: [companyId], references: [id])
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int      @default(30)

  @@index([companyId, providerId])
}

model Appointment {
  id           String            @id @default(cuid())
  companyId    String            @default("cmp_comet")
  tenant       Company           @relation(fields: [companyId], references: [id])
  code         String            @unique
  patient      User?             @relation("PatientAppointments", fields: [patientId], references: [id])
  patientId    String?
  patientName  String
  patientEmail String
  patientPhone String?
  company      String?
  provider     Provider          @relation(fields: [providerId], references: [id])
  providerId   String
  date         String
  startTime    String
  endTime      String
  type         String            @default("Consultation")
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([companyId, providerId, date, status])
  @@index([companyId, patientId])
}

model Inquiry {
  id        String        @id @default(cuid())
  companyId String        @default("cmp_comet")
  tenant    Company       @relation(fields: [companyId], references: [id])
  kind      InquiryKind
  name      String
  company   String?
  email     String
  phone     String?
  subject   String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([companyId, status])
}

model Testimonial {
  id        String    @id @default(cuid())
  companyId String    @default("cmp_comet")
  tenant    Company   @relation(fields: [companyId], references: [id])
  name      String
  role      String
  quote     String
  rating    Int       @default(5)
  approved  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model BusinessDocument {
  id            String         @id @default(cuid())
  companyId     String         @default("cmp_comet")
  tenant        Company        @relation(fields: [companyId], references: [id])
  number        String         @unique
  kind          DocumentKind
  title         String
  status        DocumentStatus @default(DRAFT)
  currency      String         @default("KES")
  taxRate       Float          @default(0.16)
  issueDate     String
  dueDate       String?
  validUntil    String?
  clientName    String
  clientCompany String
  clientEmail   String
  clientPhone   String?
  notes         String?
  subtotal      Float          @default(0)
  tax           Float          @default(0)
  total         Float          @default(0)
  data          Json?
  company       Json?
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([companyId, kind])
  @@index([companyId, status])
  @@index([companyId, clientEmail])
}
