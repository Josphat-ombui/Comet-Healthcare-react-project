  companyId   String         @default("cmp_comet")
  tenant      Company        @relation(fields: [companyId], references: [id])
  paymentId   String
  payment     FinancePayment @relation(fields: [paymentId], references: [id])
  invoiceId   String
  invoice     FinanceInvoice @relation(fields: [invoiceId], references: [id])
  amountCents Int
  createdAt   DateTime       @default(now())

  @@unique([paymentId, invoiceId])
}

model FinanceBudget {
  id             String             @id @default(cuid())
  companyId      String             @default("cmp_comet")
  tenant         Company            @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  code           String
  name           String
  period         BudgetPeriod
  startDate      String
  endDate        String
  status         BudgetStatus       @default(DRAFT)
  approvedById   String?
  approvedBy     User?              @relation("FinanceBudgetApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  classification DataClassification @default(INTERNAL)
  createdById    String?
  createdBy      User?              @relation("FinanceBudgetCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines FinanceBudgetLine[]

  @@unique([companyId, code])
}

model FinanceBudgetLine {
  id          String         @id @default(cuid())
  companyId   String         @default("cmp_comet")
  tenant      Company        @relation(fields: [companyId], references: [id])
  budgetId    String
  budget      FinanceBudget  @relation(fields: [budgetId], references: [id])
  accountId   String
  account     FinanceAccount @relation(fields: [accountId], references: [id])
  amountCents Int
  createdAt   DateTime       @default(now())

  @@unique([budgetId, accountId])
}

model EtimsSubmission {
  id                String         @id @default(cuid())
  companyId         String         @default("cmp_comet")
  tenant            Company        @relation(fields: [companyId], references: [id])
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  invoiceId         String
  invoice           FinanceInvoice @relation(fields: [invoiceId], references: [id])
  payloadVersion    String
  status            EtimsStatus    @default(QUEUED)
  provider          String?
  externalReference String?
  attempts          Int            @default(0)
  lastError         String?
  payload           Json?
  queuedAt          DateTime       @default(now())
  submittedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([companyId, invoiceId])
  @@index([companyId, status])
}
